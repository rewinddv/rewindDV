# Public project inputs only. Keep private history, builds and captures out.
/*
!/.gitignore
!/README.md
!/INSTALL.md
!/UNINSTALL.md
!/TEST-REPORT.md
!/ACKNOWLEDGMENTS.md
!/ASFireWire-LICENSE.txt
!/ASFireWire-NOTICE.txt
!/ThirdPartyNotices.txt
!/PRIVACY.md
!/RELEASE-NOTES.md
!/assets/
/assets/*
!/assets/rewinddv-icon.png
!/assets/sponsor-heading.svg
!/.github/
/.github/*
!/.github/FUNDING.yml
!/.github/ISSUE_TEMPLATE/
/.github/ISSUE_TEMPLATE/*
!/.github/ISSUE_TEMPLATE/test-report.md

# Reviewed public source and contributor documentation.
!/Foundation/
!/ASFWDriver/
!/tests/
!/tools/
!/licenses/
!/release/
!/.github/workflows/
!/.github/ISSUE_TEMPLATE/bug-report.md
!/BUILDING.md
!/COMPATIBILITY.md
!/CONTRIBUTING.md
!/INSTALLATION-PLAN.md
!/KNOWN-LIMITATIONS.md
!/LICENSE
!/NOTICE
!/SOURCE-PROVENANCE.txt
!/TESTING.md
!/BRANDING-AND-FUNDING.md
!/RELEASING.md

# Local products, caches, credentials and original recordings are never source.
.DS_Store
.build/
.swiftpm/
DerivedData/
xcuserdata/
*.xcuserstate
*.app/
*.dext/
*.provisionprofile
*.p12
*.key
*.zip
*.dmg
*.pkg
*.dv
*.m2t
